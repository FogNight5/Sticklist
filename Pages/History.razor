@page "/history"
@using System.Text.Json
@inject EntryStorageService EntryStorageService

<PageTitle>History</PageTitle>

<div class="history">
    <h1>History</h1>

    @if (entries.Count == 0)
    {
        <p class="empty">No entries yet</p>
    }
    else
    {
        <ul class="entry-list">
            @for (var i = entries.Count - 1; i >= 0; i--)
            {
                <li>@entries[i].Timestamp.ToString("MMM d, yyyy, HH:mm")</li>
            }
        </ul>
    }

    <button class="import-button" @onclick="OpenImport">Import entries</button>

    <button class="delete-button" disabled="@(entries.Count == 0)" @onclick="OpenConfirm">Delete all entries</button>

    <a class="back-link" href="">Back</a>
</div>

@if (showConfirm)
{
    <div class="overlay">
        <div class="dialog">
            <h2>Delete all entries?</h2>
            <p>This will permanently delete all @entries.Count entries for "@topic.Name". This cannot be undone.</p>
            <p>Type <strong>@topic.Name</strong> to confirm.</p>
            <input @bind="confirmText" @bind:event="oninput" placeholder="@topic.Name" />
            <div class="dialog-actions">
                <button class="cancel-button" @onclick="CloseConfirm">Cancel</button>
                <button class="confirm-delete-button" disabled="@(confirmText != topic.Name)" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@if (showImport)
{
    <div class="overlay">
        <div class="dialog">
            <h2>Import entries</h2>
            <p>Paste JSON or choose a file. Expected format: <code>[{"Timestamp":"2026-01-01T10:00:00"}]</code></p>
            <InputFile OnChange="HandleFileSelected" accept=".json,application/json" />
            <textarea @bind="importText" @bind:event="oninput" rows="6" placeholder='[{"Timestamp":"2026-01-01T10:00:00"}]'></textarea>
            @if (importError is not null)
            {
                <p class="import-error">@importError</p>
            }
            <div class="dialog-actions">
                <button class="cancel-button" @onclick="CloseImport">Cancel</button>
                <button class="import-submit-button" disabled="@string.IsNullOrWhiteSpace(importText)" @onclick="SubmitImport">Import</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly Topic topic = new() { Id = 1, Name = "Daily task" };

    private List<Entry> entries = new();
    private bool showConfirm;
    private string confirmText = "";
    private bool showImport;
    private string importText = "";
    private string? importError;

    protected override async Task OnInitializedAsync()
    {
        entries = await EntryStorageService.GetEntriesAsync();
    }

    private void OpenConfirm()
    {
        showConfirm = true;
        confirmText = "";
    }

    private void CloseConfirm()
    {
        showConfirm = false;
        confirmText = "";
    }

    private async Task ConfirmDelete()
    {
        await EntryStorageService.ClearEntriesAsync();
        showConfirm = false;
        confirmText = "";
    }

    private void OpenImport()
    {
        showImport = true;
        importText = "";
        importError = null;
    }

    private void CloseImport()
    {
        showImport = false;
        importText = "";
        importError = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importError = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            importText = await reader.ReadToEndAsync();
        }
        catch (Exception)
        {
            importError = "Could not read the selected file.";
        }
    }

    private async Task SubmitImport()
    {
        importError = null;
        try
        {
            await EntryStorageService.ImportEntriesAsync(importText);
            showImport = false;
            importText = "";
        }
        catch (JsonException)
        {
            importError = "That doesn't look like valid entries JSON.";
        }
    }
}
